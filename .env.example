# Maximum download size for video in megabytes
MAX_DOWNLOAD_SIZE_MB=100

# Download timeout in seconds
DOWNLOAD_TIMEOUT_SECONDS=60

# FFmpeg conversion timeout in seconds
CONVERSION_TIMEOUT_SECONDS=120

# Minutes before temporary job files are cleaned up
CLEANUP_AFTER_MINUTES=30

# Default MP3 audio bitrate (128k, 192k, 256k, 320k)
DEFAULT_BITRATE=192k

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional custom binary paths (leave blank to use system PATH or bundled binaries)
FFMPEG_PATH=
FFPROBE_PATH=

# Rate limit per IP
RATE_LIMIT=30/minute
